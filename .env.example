# Environment Configuration Variables (Template)
# Copy this file to .env and set the appropriate local paths and parameters.
# NOTE: Do NOT commit .env containing sensitive information or local machine paths.

# Dataset Configuration
DATASET_RAW_DIR=data/raw
DATASET_PROCESSED_DIR=data/processed
DATASET_SAMPLE_DIR=data/sample

# Model & Artifact Storage
MODEL_SAVE_DIR=models
RESULTS_METRICS_DIR=results/metrics
RESULTS_GRAPHS_DIR=results/graphs
RESULTS_CONFUSION_DIR=results/confusion_matrices
RESULTS_SHAP_DIR=results/shap

# Execution & Reproducibility Settings
RANDOM_SEED=42
LOG_LEVEL=INFO

# Future Streaming Pipeline Configuration (Placeholders for Later Phases)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRAFFIC=network-flows
KAFKA_TOPIC_ALERTS=ids-alerts
NETWORK_INTERFACE=eth0
